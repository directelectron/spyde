{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@guides/*": ["../guides/*"],
      // Raw TypeScript through an alias, matching the resolve.alias in
      // electron.vite.config.ts — see the note there.
      "@de/shell-renderer": ["../packages/shell-renderer/src/index.ts"],
      // Pinned so the shell package, which is compiled under THIS config,
      // resolves the same React types the app does. Two copies of @types/react
      // in one program produce structurally-identical-but-unassignable JSX
      // types, and the errors point at the component rather than the cause.
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": [
    "src/renderer/src/**/*", "../guides/**/*",
    "../packages/shell-renderer/src/**/*"
  ],
  // *.test.ts run under `node --test` (native TS strip), not in the browser
  // bundle, and they use explicit .ts import specifiers that node's ESM
  // resolver needs but tsc's bundler resolution rejects (TS5097). Their own
  // run is the gate — see the root `npm run test:unit`.
  "exclude": ["../packages/*/src/**/*.test.ts"]
}
