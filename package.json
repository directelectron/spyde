{
  "name": "de-apps-root",
  "private": true,
  "description": "Monorepo root — shared shell in packages/, apps in apps/ (SpyDE still at electron/ + spyde/).",
  "workspaces": [
    "packages/*",
    "electron",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace spyde-electron run dev",
    "build": "npm --workspace spyde-electron run build",
    "preview": "npm --workspace spyde-electron run preview",
    "test": "npm --workspace spyde-electron test",
    "typecheck": "npm --workspace spyde-electron run typecheck",
    "test:unit": "npm run test:unit --workspaces --if-present"
  }
}
