# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
# ...but electron/build/ is electron-builder's buildResources dir — TRACKED source
# (icons, entitlements.mac.plist for macOS signing), not build output. Un-ignore it.
!electron/build/
!electron/build/**
dist/
*.spec          # PyInstaller specs — SpyDE bundles via PyCrucible, not PyInstaller

# Virtual environments
.venv/
.venv2/
venv/

# IDE / editor
.idea/
.vscode/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Stray output / scratch
*regression_output.txt
test_*.txt
test_output*.txt
test_results.txt
test_summary.txt
test_std*.txt
verify_*.png
verify_*.py
compare_nav_blur_methods.py

# macOS
.DS_Store

# Node / Electron build output
node_modules/
electron/out/
*.tsbuildinfo

# Playwright output + screenshots written by E2E specs (the committed fixture is
# tests/fixtures/ipf_key.png; the rest under fixtures/ are regenerated by gen_ipf*.py)
test-results/
playwright-report/
electron/*.png
electron/tests/fixtures/*.html
electron/tests/fixtures/ipf_ref.png
electron/tests/fixtures/*_updates.json

# Sphinx / generated docs
doc/_build/
doc/examples/
doc/spyde/
doc/sg_execution_times.rst
# Tutorial screenshots, mirrored from docs-site/public/media/ at build time by
# conf.py's _copy_guide_media (the PNGs are committed once, over there).
# NB doc/tutorials/*.rst IS tracked — it is generated by
# scripts/gen_guide_docs.mjs and committed so a docs build needs no Node.
doc/tutorials/media/

# Local example data
*.hspy

# E2E screenshot output dirs (one per verification session; see CLAUDE.md
# "Screenshot each stage to electron/<name>_shots/")
electron/*_shots/

# Local dev debris
JSLog
# `reports/` at the root is scratch output (probe logs, one-off analysis notes)
# and stays ignored. But the pattern has no anchor, so it matched a directory of
# that name at ANY depth and silently swallowed two trees that must be tracked:
# the docs Reports page, and the exported report pages + poster QR codes the
# docs build serves. Negating the DIRECTORY is what lets git descend again — an
# excluded directory is pruned, so `!doc/reports/index.rst` alone would not have
# worked. (The published-report catalogue lives in report-catalogue/ precisely
# to stay clear of this.)
reports/
!/doc/reports/
!/docs-site/public/media/reports/
.claude/
tools/rcedit.exe
spyde/*.svg.*.svg

# Presentation source datasets — hundreds of MB, regenerable, never committed
doc/presentations/

# Working notes — see CLAUDE.md, "Working notes and PR screenshots are NOT
# tracked". Plan/handoff/architecture markdown belongs to one branch, not to
# main. Anchored to the root (and to the one real directory) so an unrelated
# nested file of the same name is not silently hidden — the `reports/` lesson
# above. This list can only cover names we have already been bitten by; a new
# note under a new name still needs the rule applied by hand.
/HANDOFF.md
/OVERNIGHT.md
/PARITY.md
/ARCHITECTURE-SPLIT.md
/docs/notes/
# the junction to the installed shell's TypeScript (electron/scripts/shell-link.mjs)
electron/shell
