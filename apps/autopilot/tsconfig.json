{
  "include": [
    "electron.vite.config.*",
    "src/**/*",
    "../../packages/shell-main/src/**/*",
    "../../packages/shell-renderer/src/**/*",
    "../../packages/shell-preload/src/**/*"
  ],
  "exclude": ["../../packages/*/src/**/*.test.ts"],
  "compilerOptions": {
    "types": ["electron-vite/node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@de/shell-main": ["../../packages/shell-main/src/index.ts"],
      "@de/shell-renderer": ["../../packages/shell-renderer/src/index.ts"],
      "@de/shell-preload": ["../../packages/shell-preload/src/index.ts"]
    }
  }
}
