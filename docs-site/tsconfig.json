{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@guides/*": ["../guides/*"],
      "@reports/*": ["../report-catalogue/*"]
    }
  },
  "include": ["src/**/*", "../guides/**/*", "../report-catalogue/**/*"]
}
